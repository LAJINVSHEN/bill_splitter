# even – environment variables.
# Copy to `.env` at the REPO ROOT (gitignored). The backend reads it via
# backend/app/config.py; real environment variables override it. Never commit secrets.

# ----------------------------------------------------------------------------- App
# development | test | production (production hides /docs and the dev routes)
ENVIRONMENT=development
# Product name (API title, logs)
APP_NAME=even
# Python log level for the API
LOG_LEVEL=INFO
# Month boundaries for quotas/usage are computed in this timezone
APP_TIMEZONE=Asia/Singapore
# Home currency for new users' bills (any ISO 4217 code in shared/currencies.json). Bills may use any
# currency; conversion only ever uses rates the user types in (no FX API).
DEFAULT_CURRENCY=SGD
# Frontend origin; used to build full share-link URLs (e.g. https://bill-splitter.pages.dev)
PUBLIC_APP_URL=http://localhost:3000
# Comma-separated CORS allowlist (exact origins, no trailing slash, never *)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----------------------------------------------------------------------------- Database
# Postgres URL. Local: the docker compose db on port 5433.
# Supabase: use the SESSION pooler (aws-0-ap-southeast-1.pooler.supabase.com:5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/bill_splitter
# auto (require TLS for *.supabase.com/co hosts) | require | disable
DATABASE_SSL=auto
# auto (off for the transaction pooler on :6543) | true | false – asyncpg prepared statements
DB_DISABLE_PREPARED_STATEMENTS=auto
# SQLAlchemy pool size / overflow (Supabase free pooler has few connections)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ----------------------------------------------------------------------------- Supabase / auth
# Project URL, e.g. https://<ref>.supabase.co (JWKS + issuer + Auth admin + Storage)
SUPABASE_URL=
# Publishable/anon key – used by the FRONTEND only (VITE_SUPABASE_ANON_KEY), not by the API
SUPABASE_ANON_KEY=
# Legacy HS256 JWT secret (fallback when a token isn't signed by a JWKS key). Dev tokens use it.
SUPABASE_JWT_SECRET=
# Service-role / sb_secret key – SERVER ONLY (Auth admin API + Storage). Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# supabase | fake  (fake = in-memory user admin for local dev/tests)
SUPABASE_ADMIN_BACKEND=supabase
# Username logins become {username}@{AUTH_EMAIL_DOMAIN} in Supabase Auth (no mail is ever sent)
AUTH_EMAIL_DOMAIN=users.even.app
# DEV ONLY. /api/dev/auth/login (mounted only when ENVIRONMENT != production AND
# SUPABASE_ADMIN_BACKEND=fake) accepts this password for users the in-memory fake admin doesn't
# know, e.g. the `python -m app.cli dev-seed` users. Empty = reject. Never set in production.
DEV_LOGIN_PASSWORD=
# Expected JWT audience
JWT_AUDIENCE=authenticated
# Clock-skew tolerance when checking exp/iat
JWT_LEEWAY_SECONDS=30
# How long fetched JWKS keys are cached
JWKS_CACHE_SECONDS=600

# ----------------------------------------------------------------------------- OCR (Azure Document Intelligence)
# azure | fake
OCR_BACKEND=azure
# Resource endpoint, e.g. https://<name>.cognitiveservices.azure.com/
AZURE_DI_ENDPOINT=
# Resource key
AZURE_DI_KEY=
# Max concurrent Azure calls across all scans (F0 is rate-limited)
OCR_MAX_CONCURRENCY=2
# Pages analysed per PDF (F0 only processes the first 2 anyway)
OCR_MAX_PDF_PAGES=2
# Per-file analysis timeout
OCR_TIMEOUT_SECONDS=90

# ----------------------------------------------------------------------------- LLM (OpenAI)
# openai | fake
LLM_BACKEND=openai
# Project-scoped OpenAI key
OPENAI_API_KEY=
# Fast model tried first
LLM_PRIMARY_MODEL=gpt-6-luna
# none | low | medium | high … (blank = model default)
LLM_PRIMARY_REASONING_EFFORT=low
# Stronger model used when the primary errors, times out or fails totals reconciliation (blank = none)
LLM_FALLBACK_MODEL=gpt-6.1-sol
LLM_FALLBACK_REASONING_EFFORT=low
# Per-request timeout and SDK retries
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
# Output-token ceiling per call (includes reasoning tokens)
LLM_MAX_OUTPUT_TOKENS=8000
# Optional JSON override of the USD-per-1M-token price table used for cost estimates, e.g.
# {"gpt-6-luna":{"input":"0.10","cached_input":"0.01","output":"0.50"}}
# LLM_PRICES=

# ----------------------------------------------------------------------------- Storage
# local (files under LOCAL_STORAGE_DIR, dev/tests) | supabase (private bucket; use in production)
STORAGE_BACKEND=local
# Supabase Storage bucket (private)
STORAGE_BUCKET=receipts
# Where local files go (default: <repo>/.local/storage)
# LOCAL_STORAGE_DIR=
# Lifetime of signed receipt URLs
SIGNED_URL_TTL_SECONDS=300
# Receipt photos are deleted this many days after upload (bill data is kept)
RECEIPT_RETENTION_DAYS=90

# ----------------------------------------------------------------------------- Scans / jobs
# Files per scan and bytes per file (Azure F0 limit is 4 MB)
SCAN_MAX_FILES=5
SCAN_MAX_FILE_BYTES=4194304
# Running jobs write a heartbeat this often; older than JOB_STALE_SECONDS = interrupted
JOB_HEARTBEAT_SECONDS=10
JOB_STALE_SECONDS=90

# ----------------------------------------------------------------------------- Quotas (seed values; admin-editable in /admin)
# Default monthly OCR pages per new user
DEFAULT_USER_MONTHLY_QUOTA=30
# All users together, per month (keep below Azure F0's 500)
GLOBAL_MONTHLY_PAGE_CAP=450
# All users together, per month, in USD (set slightly below the OpenAI project budget)
GLOBAL_MONTHLY_LLM_BUDGET_USD=5

# ----------------------------------------------------------------------------- Guardrails
# Turn rate limiting off only for local experiments
RATE_LIMIT_ENABLED=true
# Every /api route, per user (or per IP when anonymous)
RATE_LIMIT_DEFAULT=300/minute
# Scan creation + retry, per user
RATE_LIMIT_SCANS=10/minute;100/day
# Public share view, per IP
RATE_LIMIT_PUBLIC=30/minute
# Admin user creation / password reset
RATE_LIMIT_ADMIN_CREATE=20/hour
# Max JSON request body (scan uploads get SCAN_MAX_FILES × SCAN_MAX_FILE_BYTES)
MAX_JSON_BODY_BYTES=262144
# Bearer secret for POST /api/internal/maintenance (same value as the GitHub Actions secret)
CRON_SECRET=

# ----------------------------------------------------------------------------- Frontend build (Vite, read by frontend/)
# API base URL baked into the SPA build (empty = same origin / dev proxy)
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Must equal AUTH_EMAIL_DOMAIN (the login form maps a username to this email)
VITE_AUTH_EMAIL_DOMAIN=users.even.app

# ----------------------------------------------------------------------------- Deploy tooling (agent / CI only, never read by the app)
# Supabase personal access token (Management API: create project, auth settings)
SUPABASE_ACCESS_TOKEN=
# Render API key (create service, env vars)
RENDER_API_KEY=
# Cloudflare Pages deploy (account-scoped token with Pages:Edit)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
